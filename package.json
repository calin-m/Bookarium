{
  "name": "bookarium",
  "version": "2.9.7",
  "private": true,
  "description": "High-performance frontend for discovering, reading, and downloading 100% legal, public domain books.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:open": "concurrently -n next,browser -c blue,green \"next dev --webpack\" \"node scripts/open-browser.js http://localhost:3000 2500\"",
    "dev:all": "concurrently -n next,test,browser -c blue,magenta,green \"next dev --webpack\" \"vitest\" \"node scripts/open-browser.js http://localhost:3000 3000\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:fast": "vitest run",
    "test:ui": "vitest --ui --open",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "node scripts/verify-build.js",
    "security:audit": "node scripts/verify-build.js --security-only",
    "docs:sync": "node scripts/generate-architecture-matrix.js && node scripts/generate-parser-docs.js && node scripts/generate-changelog.js && node scripts/generate-quality-report.js && node scripts/generate-roadmap.js",
    "docs:parser": "node scripts/generate-parser-docs.js",
    "report": "node scripts/generate-quality-report.js",
    "audit:quality": "node scripts/generate-quality-report.js",
    "audit:detailed": "eslint . --max-warnings 0 && knip",
    "roadmap:generate": "node scripts/generate-roadmap.js",
    "matrix:generate": "node scripts/generate-architecture-matrix.js",
    "changelog:generate": "node scripts/generate-changelog.js",
    "verify:build": "node scripts/verify-build.js",
    "gate:approve": "node scripts/approval-gate.js",
    "catalog:ingest": "node scripts/ingest-catalog.js",
    "catalog:sync": "node scripts/sync-gutenberg-catalog.js",
    "translations:sync": "node scripts/ingest-translations.js",
    "quotes:sync": "node scripts/sync-featured-quotes.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "fast-glob": "npm:tinyglobby@^0.2.17",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "knip": "^6.44.2",
    "msw": "^2.15.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
