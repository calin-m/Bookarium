{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/components/**/*.{ts,tsx}",
    "src/hooks/**/*.{ts,tsx}",
    "src/stores/**/*.{ts,tsx}",
    "src/lib/**/*.{ts,tsx}",
    "src/types/**/*.{ts,tsx}",
    "src/mocks/**/*.{ts,tsx}",
    "scripts/**/*.js"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.js"
  ],
  "ignoreDependencies": [
    "husky"
  ],
  "ignoreExportsUsedInFile": true
}
