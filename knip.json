{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/workers/**/*.{ts,tsx}",
    "src/components/motion/**/*.{ts,tsx}",
    "src/mocks/**/*.{ts,tsx}",
    "src/test/**/*.{ts,tsx}",
    "src/**/*.test.{ts,tsx}",
    "scripts/**/*.js",
    "scripts/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.js",
    "scripts/**/*.test.ts"
  ],
  "exclude": [
    "types"
  ],
  "ignoreDependencies": [
    "husky"
  ],
  "ignoreExportsUsedInFile": true
}
