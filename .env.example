# ==============================================================================
# Bookarium — Environment Variable Template (.env.example)
# ==============================================================================
# QUICK PLATFORM PLACEMENT REFERENCE:
#
# 1. Vercel Project Settings (Production & Preview Deployments):
#    - NEXT_PUBLIC_SITE_URL
#    - NEXT_PUBLIC_SUPABASE_URL
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - NEXT_PUBLIC_GITHUB_REPO (Optional, custom repository link)
#    - NEXT_PUBLIC_TURNSTILE_SITE_KEY (Optional, Cloudflare Turnstile bot protection)
#    - NEXT_PUBLIC_LEGAL_CONTACT_FORM (Optional, external Google Form/Tally intake)
#    - NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION (Optional, Google Search Console ownership token)
#
# 2. GitHub Actions Secrets (Settings -> Secrets and variables -> Actions):
#    - NEXT_PUBLIC_SUPABASE_URL
#    - SUPABASE_SERVICE_ROLE_KEY
#    - GUTENBERG_CONTACT_EMAIL (Optional maintainer contact for Gutenberg headers)
#
# 3. Local Development (.env.local - never committed to git):
#    - Copy this template to .env.local and populate the values below.
#
# 4. Supabase Dashboard (Where to find database keys):
#    - Project Settings -> API -> Project URL & Project API Keys (anon public, service_role secret).
# ==============================================================================

# ------------------------------------------------------------------------------
# Section 1: Public Web App Variables (Configured in Vercel & .env.local)
# ------------------------------------------------------------------------------

# Canonical Domain & Production URL
NEXT_PUBLIC_SITE_URL=https://bookarium.vercel.app

# Optional: Hosted Git Repository Link (Displayed in Navbar, Footer & Copyright Intake)
# If omitted, auto-detected from GITHUB_REPOSITORY (CI) or VERCEL_GIT_REPO_* (Vercel).
NEXT_PUBLIC_GITHUB_REPO=

# Optional: Supabase Database, Cloud Sync & Authentication
# Required only if self-hosting the full-text catalog or enabling multi-device sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile Bot Protection for Supabase Authentication
# When configured alongside Supabase Attack Protection, renders a Managed Turnstile widget in AuthModal and /account recovery/verification flows.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: Confidential Legal & DMCA Intake Form (e.g. Google Forms / Tally)
# If left empty, copyright intake gracefully falls back to the GitHub Repository Issue Tracker.
NEXT_PUBLIC_LEGAL_CONTACT_FORM=

# Optional: Google Search Console & OAuth Brand Verification Token
# Set to the `content` attribute value from Google Search Console's HTML meta tag (<meta name="google-site-verification" content="...">).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ------------------------------------------------------------------------------
# Section 2: Server-Only & CLI Variables (Never prefix with NEXT_PUBLIC_)
# Configured in GitHub Actions Secrets (for cron sync) and .env.local (for local CLI runs).
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to client code or browser bundles.
# ------------------------------------------------------------------------------

# Database Admin Key (Used exclusively by offline CLI pipelines: npm run catalog:sync, etc.)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Contact Email for Automated Upstream User-Agent Headers (Project Gutenberg / Wikidata)
# Appended to automated requests when configured. If blank, User-Agent cleanly falls back to the repository URL.
# GUTENBERG_CONTACT_EMAIL=

# Optional: Explicit Repository URL Override for CLI Scripts & Attribution
# Automatically detected from local git config, GITHUB_REPOSITORY (CI), or VERCEL_GIT_REPO_* (Vercel) if omitted.
# BOOKARIUM_REPO_URL=

# Optional: Local Development Jurisdiction Override (ISO 3166-1 alpha-2, e.g. US, RO, DE, MX)
# DEV_COUNTRY=
