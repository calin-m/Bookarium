# ==============================================================================
# Bookarium — Environment Variable Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, configure these variables in your Vercel Project Settings.

# Canonical Domain & Production URL
NEXT_PUBLIC_SITE_URL=https://bookarium.vercel.app

# Optional: Supabase Database, Cloud Sync & Authentication
# Required only if self-hosting the full-text catalog or enabling multi-device sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Confidential Legal & DMCA Intake Form (e.g. Google Forms / Tally)
# If left empty, copyright intake gracefully falls back to the GitHub Repository Issue Tracker.
NEXT_PUBLIC_LEGAL_CONTACT_FORM=

# ==============================================================================
# Server-Only & CLI Variables (Never prefix with NEXT_PUBLIC_)
# ==============================================================================
# Used exclusively by offline CLI pipelines (npm run catalog:sync, npm run translations:sync).
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to client code or browser bundles.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Custom Upstream Gutendex Endpoint Override (Server-side only)
# GUTENDEX_API_URL=https://gutendex.com/books

# Optional: Local Development Jurisdiction Override (ISO 3166-1 alpha-2, e.g. US, RO, DE, MX)
# DEV_COUNTRY=

